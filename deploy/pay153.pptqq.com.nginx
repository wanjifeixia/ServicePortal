server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name pay153.pptqq.com;

  ssl_certificate /etc/nginx/ssl/pptqq.com.pem;
  ssl_certificate_key /etc/nginx/ssl/pptqq.com.key;
  ssl_protocols TLSv1.2 TLSv1.3;

  location = /paypal-pay {
    return 301 /paypal-pay/;
  }

  location /paypal-pay/ {
    proxy_pass http://127.0.0.1:18097/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Prefix /paypal-pay;
    proxy_read_timeout 650s;
    proxy_send_timeout 650s;
  }

  location / {
    proxy_pass http://127.0.0.1:18096;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 650s;
    proxy_send_timeout 650s;
  }
}
